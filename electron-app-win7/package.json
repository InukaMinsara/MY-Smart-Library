{
  "name": "smart-library-pro-win7",
  "version": "2.0.0",
  "description": "Smart Library Pro Desktop Application (Windows 7/8)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -w"
  },
  "author": "Smart Library",
  "license": "ISC",
  "build": {
    "appId": "com.smartlibrary.pro.win7",
    "productName": "Smart Library Pro (Win7)",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version} ${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3"
  }
}
