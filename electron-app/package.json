{
  "name": "smart-library-pro",
  "version": "2.0.0",
  "description": "Smart Library Pro Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -w"
  },
  "author": "Smart Library",
  "license": "ISC",
  "build": {
    "appId": "com.smartlibrary.pro",
    "productName": "Smart Library Pro",
    "directories": {
      "output": "dist"
    },
    "protocols": {
      "name": "smartlibrary",
      "schemes": [
        "smartlibrary"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version} ${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  }
}
